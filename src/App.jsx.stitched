              </tr>
              <tr>
                <td className="font-semibold table-highlight-text">
                  <a href="https://www.theice.com/products/254/Cotton-No-2-Futures" target="_blank" rel="noopener noreferrer" className="flex items-center gap-1 hover:underline">
