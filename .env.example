# .env.example
# Environment variables for BASML Cotton Yarn Dashboard (Vite version)
# Copy this file to .env and add your actual API keys

# Quandl API (for ICE Cotton prices)
# Get free API key at: https://data.nasdaq.com
VITE_QUANDL_KEY=your_quandl_api_key_here
REACT_APP_QUANDL_KEY=your_quandl_api_key_here

# MCX India API (if using licensed feed)
# Contact: datafeed@mcxindia.com
VITE_MCX_API_KEY=your_mcx_key_here
REACT_APP_MCX_API_KEY=your_mcx_key_here

# API Configuration
VITE_API_TIMEOUT=5000
VITE_REFRESH_INTERVAL=300000

# Environment
VITE_ENV=development

# Data freshness thresholds (in minutes)
VITE_FRESH_THRESHOLD=15
VITE_STALE_THRESHOLD=60

# Enable/disable features
VITE_ENABLE_LIVE_DATA=true
VITE_ENABLE_ANALYTICS=false

# Timezone for timestamps
VITE_TIMEZONE=Asia/Kolkata
